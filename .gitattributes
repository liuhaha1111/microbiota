# 统一行尾，避免脚本在 clone 到 Windows 后出现解析问题

# 批处理必须是 CRLF —— 部分 cmd 对 LF 结尾的 .bat 解析异常
*.bat   text eol=crlf
*.cmd   text eol=crlf

# PowerShell 脚本在 Windows 上运行，同样给 CRLF
*.ps1   text eol=crlf

# 源码与文档统一 LF
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf

# 二进制，不做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
